# RentEase — environment
# Copy to .env.local and fill in. `pnpm supabase start` prints the local values.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role bypasses RLS. Server-only, never NEXT_PUBLIC_, and only the cron
# routes and webhooks may use it (enforced by an eslint rule, see eslint.config.mjs).
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) -------------------------------------------------------
# Leave RESEND_API_KEY empty in development: the notification layer then logs
# messages to the console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="RentEase <billing@example.com>"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the daily reminder cron must present. Batch 2B.
CRON_SECRET=

# --- Stripe (Batch 3) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
